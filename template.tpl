___TESTS___

scenarios:
- name: First visit declares all four signals denied and loads the engine
  code: |-
    mock('getCookieValues', function () { return []; });
    let injected;
    mock('injectScript', function (url, onSuccess) { injected = url; onSuccess(); });
    runCode(mockData);
    assertApi('setDefaultConsentState').wasCalledWith({
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });
    assertApi('updateConsentState').wasNotCalled();
    assertThat(injected).isEqualTo('https://cdn.katla.app/fc92b6df-034c-42a9-af5c-397971caa002.consent.js');
    assertApi('gtmOnSuccess').wasCalled();
- name: Returning visitor who accepted everything is updated to granted
  code: |-
    mock('getCookieValues', function () { return ['all|1790257034']; });
    runCode(mockData);
    assertApi('updateConsentState').wasCalledWith({
      analytics_storage: 'granted',
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted'
    });
- name: Returning visitor who allowed analytics only keeps the ad signals denied
  code: |-
    mock('getCookieValues', function () { return ['functional,analytics|1790257034']; });
    runCode(mockData);
    assertApi('updateConsentState').wasCalledWith({
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
- name: A pinned language is passed to the engine
  code: |-
    mock('getCookieValues', function () { return []; });
    let injected;
    mock('injectScript', function (url, onSuccess) { injected = url; onSuccess(); });
    mockData.locale = 'EN';
    runCode(mockData);
    assertThat(injected).isEqualTo('https://cdn.katla.app/fc92b6df-034c-42a9-af5c-397971caa002.consent.js?locale=en');
setup: |-
  const mockData = {
    siteId: 'fc92b6df-034c-42a9-af5c-397971caa002',
    waitForUpdate: 500
  };



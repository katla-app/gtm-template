___SANDBOXED_JS_FOR_WEB_TEMPLATE___

/*
 * Katla Cookie Consent for Google Tag Manager.
 *
 * The Custom HTML install declared the Consent Mode default from a script GTM inserts into
 * the page, which runs after the Initialization event: Google tags on that trigger read
 * consent before any default existed, and Tag Assistant says so. setDefaultConsentState
 * applies while Consent Initialization is still running, ahead of every other tag.
 *
 * Order matters, and is the same as the hosted loader's:
 *  1. Declare the default: all four signals denied, with wait_for_update.
 *  2. A returning visitor's stored choice becomes an update straight away, read from the
 *     same cookie and parsed the same way as the loader does, so their first page view is
 *     measured with the consent they already gave.
 *  3. Load the Katla engine. It sees __katlaGcmDefault and does not declare a second
 *     default; it sends the update when the visitor chooses.
 */
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const gtagSet = require('gtagSet');
const encodeUriComponent = require('encodeUriComponent');
const makeNumber = require('makeNumber');

const CDN = 'https://cdn.katla.app/';
const DEFAULT_WAIT_FOR_UPDATE = 500;

// All four signals from two answers: may we store analytics, and may we store advertising.
function signals(analytics, ads) {
  return {
    analytics_storage: analytics ? 'granted' : 'denied',
    ad_storage: ads ? 'granted' : 'denied',
    ad_user_data: ads ? 'granted' : 'denied',
    ad_personalization: ads ? 'granted' : 'denied'
  };
}

// Mirrors getConsent() in the engine, which is what its own default is built from: the
// cookie is the contract between them.
function storedSignals() {
  const values = getCookieValues('_katla_consent');
  if (!values || values.length === 0 || !values[0]) return null;
  const stored = values[0].split('|')[0];
  if (stored === 'all') return signals(true, true);
  // A CCPA opt-out reads back as ['functional'] in the engine, and it blocks analytics
  // cookies on that basis, so every signal is denied rather than just the ad ones.
  if (stored === 'opted_out') return signals(false, false);
  if (stored.indexOf('rejected:') !== 0) {
    const categories = stored.split(',');
    return signals(
      categories.indexOf('analytics') !== -1,
      categories.indexOf('marketing') !== -1
    );
  }
  return signals(false, false);
}

const waitForUpdate =
  data.waitForUpdate === undefined || data.waitForUpdate === ''
    ? DEFAULT_WAIT_FOR_UPDATE
    : makeNumber(data.waitForUpdate);

const defaults = signals(false, false);
defaults.wait_for_update = waitForUpdate;
setDefaultConsentState(defaults);

if (data.adsDataRedaction) gtagSet('ads_data_redaction', true);
if (data.urlPassthrough) gtagSet('url_passthrough', true);

const stored = storedSignals();
if (stored) updateConsentState(stored);

// Tells the engine the default is already declared. A second 'default' arriving after
// Google's tags have read this one can clobber it.
setInWindow('__katlaGcmDefault', 1, true);

// Without a language the engine is the all-languages build, which picks the visitor's own.
let url = CDN + encodeUriComponent(data.siteId) + '.consent.js';
if (data.locale) url = url + '?locale=' + encodeUriComponent(data.locale.toLowerCase());

injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, url);


